{
  "expo": {
    "name": "The Semi Circle",
    "slug": "the-semi-circle",
    "scheme": "thesemicircle",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.thesemicircle.app"
    },
    "android": {
      "package": "in.thesemicircle.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f3ecdf",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Pick people you want to vouch for. We only read the ones you choose."
        }
      ]
    ]
  }
}
