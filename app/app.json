{
  "expo": {
    "name": "The Semi Circle",
    "slug": "the-semi-circle",
    "scheme": "thesemicircle",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.thesemicircle.app"
    },
    "android": {
      "package": "in.thesemicircle.app",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#211c16"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f3ecdf",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Pick people you want to vouch for. We only read the ones you choose."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The Semi Circle uses your photos so you can choose a profile picture."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "The Semi Circle uses your location once, to fill in the area you live in. Others only ever see the area."
        }
      ],
      "expo-notifications"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
