{"lead":1.6,"end":52.6,"title":"You’re allowed to <i>have fun.</i>",
"palette":{
 "a":{"bg":"#f4efe4","fg":"#1b1a18","ac":"#8a6a38"},
 "b":{"bg":"#cfc8b8","fg":"#25211b","ac":"#6b4f22"},
